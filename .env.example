# Local demonstration only. Fill every blank secret in a private .env file.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_PORT=55432

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_PORT=8080

PNCP_DB_NAME=pncp
PNCP_DB_USER=pncp_app
PNCP_DB_PASSWORD=

# Pipeline. Set a 14-digit CNPJ before unpausing the DAG. Leave blank only while
# the DAG will remain paused.
PNCP_API_URL=https://pncp.gov.br/api/consulta/v1/atas
PNCP_UPDATE_API_URL=https://pncp.gov.br/api/consulta/v1/atas/atualizacao
PNCP_SCHEDULE_CNPJ=
PNCP_DAG_SCHEDULE=0 6 * * *
PNCP_SCHEDULE_QUERY_MODE=vigencia
PNCP_INCREMENTAL_LOOKBACK_DAYS=2
PNCP_PAGE_SIZE=100
PNCP_MAX_PAGES=1000
PNCP_MAX_RECORDS=100000
PNCP_MAX_DURATION_SECONDS=1800
PNCP_MAX_ARTIFACT_BYTES=2147483648
PNCP_BATCH_SIZE=1000
